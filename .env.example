OPENAI_API_KEY=your-openai-api-key-here
SERPER_API_KEY=your-serper-api-key-here
DOCLING_VARIANT=none
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=
RAG_STARTUP_VALIDATION=0
# Backend-only HTTP tool administration token; blank disables these APIs.
# Never expose this through NEXT_PUBLIC_* or commit a real token.
FULL_ADMIN_TOKEN=
# UI layout and managed toolsets are independent.
# TOOLSETS=calculator,weather,graph
# ALLOWED_TOOLSETS=calculator,weather,graph,web_search,web_rag
# Backend-only administrator token for Manage toolsets and /tooling/admin.
AGENT_CHAT_ADMIN_TOKEN=
