{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-chat.dev/schemas/agent-chat/v1.json",
  "title": "Agent Chat configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "host": {"type": "string", "minLength": 1},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "model": {"type": "string", "minLength": 1},
    "default_agent": {"type": "string", "minLength": 1},
    "ui_preset": {"enum": ["minimal", "full"]},
    "api_base": {"type": "string"},
    "identity_mode": {"enum": ["anonymous", "delegated"]},
    "server_mode": {"enum": ["prod", "debug"]},
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "welcome_heading": {"type": "string", "minLength": 1, "maxLength": 500},
        "welcome_description": {"type": "string", "minLength": 1, "maxLength": 500},
        "composer_placeholder": {"type": "string", "minLength": 1, "maxLength": 500},
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "prompt"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 500},
              "label": {"type": "string", "minLength": 1, "maxLength": 500},
              "prompt": {"type": "string", "minLength": 1, "maxLength": 500},
              "agents": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "web_dir": {"type": ["string", "null"]},
    "web_full_dir": {"type": ["string", "null"]},
    "database_url": {"type": ["string", "null"]},
    "database_path": {"type": "string", "minLength": 1},
    "checkpoint_database_url": {"type": ["string", "null"]},
    "checkpoint_database_path": {"type": "string", "minLength": 1},
    "auto_migrate": {"type": "boolean"},
    "persistence_enabled": {"type": "boolean"}
  }
}
